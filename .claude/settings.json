{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f wiki/about-me.md ] && cat wiki/about-me.md || true"
          },
          {
            "type": "command",
            "command": "[ -f wiki/LESSONS.md ] && cat wiki/LESSONS.md || true"
          },
          {
            "type": "command",
            "command": "[ -f wiki/hot.md ] && cat wiki/hot.md || true"
          },
          {
            "type": "command",
            "command": "[ -x scripts/wiki-lock.sh ] && bash scripts/wiki-lock.sh clear-stale --max-age 3600 >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x scripts/stop-hook.sh ] && bash scripts/stop-hook.sh || true"
          }
        ]
      }
    ]
  }
}
